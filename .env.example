# Clés API requises (selon le provider choisi)
GEMINI_API_KEY=your_gemini_api_key_here
KIMI_API_KEY=your_kimi_api_key_here

# Control plane Neven (optionnel, utilisé uniquement par le main process)
# En production, le jeton doit venir de la session Neven, jamais d'une clé fournisseur.
NEVEN_CONTROL_PLANE_URL=https://api.neven.example
NEVEN_GATEWAY_URL=https://gateway.neven.example
NEVEN_ACCESS_TOKEN=
NEVEN_CONTROL_PLANE_ACCESS_PATH=/v1/control-plane/access/resolve
NEVEN_CONTROL_PLANE_REVOKE_PATH=/v1/control-plane/access/revoke
NEVEN_INTERNAL_EVENTS_PATH=/api/v1/internal/events
# Jeton interne lu uniquement dans le main process. Ne jamais le transmettre au renderer.
NEVEN_INTERNAL_EVENTS_TOKEN=
# Requis pour activer la télémétrie ; sans cet identifiant, aucun événement n'est publié.
NEVEN_WORKSPACE_ID=
# Hôtes distants HTTPS autorisés pour le control plane ET la passerelle, séparés par des virgules.
# Migration : renseigner api.neven.example,gateway.neven.example avant d'activer les URLs Neven.
NEVEN_CONTROL_PLANE_ALLOWED_HOSTS=

# Configuration Ollama (Optionnelle, par défaut: http://localhost:11434)
OLLAMA_URL=http://localhost:11434

# Modèles par défaut (Optionnels)
GEMINI_MODEL=gemini-3-flash-preview
KIMI_MODEL=moonshotai/Kimi-K2.5
CLAUDE_MODEL=claude-sonnet-4-6

# ── Agent WhatsApp → IDE (mode serveur iMac) ──────────────────────────────
# Token partagé entre l'IDE et le bridge (généré par setup-server.sh)
IDE_API_TOKEN=change_me_generate_with_openssl_rand_hex_16
# Dossier racine contenant tous tes projets (pré-approuvé pour l'agent)
IDE_ALLOWED_ROOTS=/home/user/projects
# Port du serveur HTTP interne de l'IDE (ne PAS exposer publiquement)
TASK_SERVER_PORT=3001
# URL interne de l'IDE (toujours localhost)
IDE_TASK_URL=http://127.0.0.1:3001

# ── WhatsApp Bridge ────────────────────────────────────────────────────────
WHATSAPP_BRIDGE_PORT=3030
WHATSAPP_VERIFY_TOKEN=change_me_verify_token
WHATSAPP_ACCESS_TOKEN=EAAG...
WHATSAPP_PHONE_NUMBER_ID=1234567890
WHATSAPP_GRAPH_VERSION=v22.0
WHATSAPP_OLLAMA_MODEL=qwen3:latest
# Requis par defaut: numeros autorises explicites. Override dev: WHATSAPP_ALLOW_ALL_SENDERS=true
# Exemple: 33612345678,33798765432
WHATSAPP_ALLOWED_NUMBERS=
WHATSAPP_ALLOW_ALL_SENDERS=false
# Requis par defaut pour verifier x-hub-signature-256 Meta. Override dev uniquement: true
WHATSAPP_APP_SECRET=
WHATSAPP_DISABLE_SIGNATURE_VERIFY=false
WHATSAPP_MAX_BODY_BYTES=1048576
WHATSAPP_SYSTEM_PROMPT=Tu es un assistant technique concis. Reponds en francais.
# Exec commandes locales depuis WhatsApp (desactive par defaut)
WHATSAPP_EXEC_ENABLED=false
WHATSAPP_EXEC_TIMEOUT_MS=30000
WHATSAPP_EXEC_MAX_OUTPUT=3000
# Exemple: ollama list,git status,git diff
WHATSAPP_EXEC_ALLOWLIST=
