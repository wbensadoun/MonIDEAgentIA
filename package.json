{
  "name": "monideagentia",
  "version": "1.4.0",
  "main": "main.js",
  "scripts": {
    "start": "concurrently \"npm:start-react\" \"npm:electron-dev\"",
    "start-react": "npm start --prefix client",
    "electron-dev": "ping 127.0.0.1 -n 6 > nul && electron .",
    "dev": "concurrently \"npm run start-react\" \"npm run electron-dev\"",
    "build": "npm run build --prefix client && electron-builder",
    "postinstall": "electron-builder install-app-deps",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "axios": "^1.7.9",
    "dotenv": "^17.2.1",
    "electron-is-dev": "^2.0.0"
  },
  "devDependencies": {
    "@types/electron": "^1.4.38",
    "@types/node": "^24.1.0",
    "concurrently": "^9.2.0",
    "electron": "^37.2.4",
    "electron-builder": "^26.0.12",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.votreentreprise.monide",
    "productName": "Mon IDE Agent IA",
    "files": [
      "main.js",
      "logger.js",
      "preload.js",
      "assets/**/*",
      "client/build/**/*"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "win": {
      "icon": "assets/iconeDesktop.png",
      "target": "portable",
      "signAndEditExecutable": false
    },
    "mac": {
      "icon": "assets/iconeDesktop.png"
    },
    "linux": {
      "icon": "assets/iconeDesktop.png"
    }
  }
}
