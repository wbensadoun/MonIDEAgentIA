{
  "name": "code-companion",
  "version": "2.4.1",
  "main": "main.js",
  "scripts": {
    "start": "concurrently \"npm:start-react\" \"npm:electron-dev\"",
    "start-react": "node scripts/start-react-dev.js",
    "electron-dev": "node scripts/electron-dev-runner.js",
    "dev": "concurrently \"npm run start-react\" \"npm run electron-dev\"",
    "whatsapp-bridge": "node scripts/whatsapp-ollama-bridge.js",
    "build": "npm run build --prefix client && electron-builder",
    "build:win-installer": "npm run build --prefix client && electron-builder --win nsis",
    "build:linux-server": "npm run build --prefix client && electron-builder --linux AppImage",
    "setup-server": "bash scripts/setup-server.sh",
    "start-server": "bash scripts/start-server.sh",
    "stop-server": "bash scripts/stop-server.sh",
    "logs-server": "bash scripts/logs-server.sh",
    "postinstall": "node scripts/postinstall.js",
    "test": "npm test --prefix client -- --watchAll=false --runInBand",
    "test:electron": "node --test electron/services/provider-management.test.js electron/services/router.service.test.js electron/services/neven-control-plane.service.test.js electron/services/neven-core.service.test.js electron/ipc/aiHandlers.test.js",
    "lint:css": "npm run lint:css --prefix client",
    "check:design-debt": "bash scripts/check-design-debt.sh"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "IDE Electron local avec agents IA multi-providers et workflows visuels.",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "axios": "^1.16.1",
    "dotenv": "^17.2.1",
    "electron-is-dev": "^2.0.0",
    "node-pty": "^1.1.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@types/electron": "^1.4.38",
    "@types/node": "^24.1.0",
    "concurrently": "^9.2.0",
    "electron": "^37.2.4",
    "electron-builder": "^26.0.12",
    "wait-on": "^7.2.0"
  },
  "overrides": {
    "axios": "^1.16.1",
    "follow-redirects": "^1.16.0"
  },
  "build": {
    "appId": "com.votreentreprise.monide",
    "productName": "Code companion",
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/node-pty/**/*"
    ],
    "files": [
      "main.js",
      "logger.js",
      "preload.js",
      "electron/**/*",
      "assets/**/*",
      "client/build/**/*",
      "client/src/utils/applySearchReplace.js"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "win": {
      "icon": "iconeDesktop.png",
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Code companion"
    },
    "mac": {
      "icon": "iconeDesktop.png"
    },
    "linux": {
      "icon": "iconeDesktop.png",
      "target": [
        "AppImage"
      ],
      "extraFiles": [
        "scripts/setup-server.sh",
        "scripts/start-server.sh",
        "scripts/stop-server.sh",
        "scripts/logs-server.sh",
        ".env.example"
      ]
    }
  }
}
