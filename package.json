{
  "name": "monideagentia",
  "version": "1.7.0",
  "main": "main.js",
  "scripts": {
    "start": "concurrently \"npm:start-react\" \"npm:electron-dev\"",
    "start-react": "npm start --prefix client",
    "electron-dev": "node scripts/electron-dev-runner.js",
    "dev": "concurrently \"npm run start-react\" \"npm run electron-dev\"",
    "whatsapp-bridge": "node scripts/whatsapp-ollama-bridge.js",
    "build": "npm run build --prefix client && electron-builder",
    "build:win-installer": "npm run build --prefix client && electron-builder --win nsis",
    "postinstall": "electron-builder install-app-deps",
    "test": "echo \"Error: no test specified\" && exit 1",
    "mcp": "node mcp-server/index.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "axios": "^1.7.9",
    "dotenv": "^17.2.1",
    "electron-is-dev": "^2.0.0",
    "puppeteer": "^24.42.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/electron": "^1.4.38",
    "@types/node": "^24.1.0",
    "concurrently": "^9.2.0",
    "electron": "^37.2.4",
    "electron-builder": "^26.0.12",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.votreentreprise.monide",
    "productName": "Mon IDE Agent IA",
    "files": [
      "main.js",
      "logger.js",
      "preload.js",
      "electron/**/*",
      "assets/**/*",
      "client/build/**/*"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "win": {
      "icon": "assets/iconeDesktop.png",
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Mon IDE Agent IA"
    },
    "mac": {
      "icon": "assets/iconeDesktop.png"
    },
    "linux": {
      "icon": "assets/iconeDesktop.png"
    }
  }
}
