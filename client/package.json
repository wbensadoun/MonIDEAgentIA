      "test": "readonly",
      "it": "readonly",
      "expect": "readonly",
      "jest": "readonly"
    }
  },
  "overrides": {
    "follow-redirects": "^1.16.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
